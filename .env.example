# Aggregate reference for the current shared development environment.
# Do not copy this file directly. Run `bun run setup:env` to create each
# package-local `.env.local` from its colocated `.env.example`.

# Convex development deployment
CONVEX_DEPLOYMENT=dev:perceptive-grasshopper-340
CONVEX_URL=https://perceptive-grasshopper-340.convex.cloud
CONVEX_SITE_URL=https://perceptive-grasshopper-340.convex.site

# Management web app
NEXT_PUBLIC_CONVEX_URL=https://perceptive-grasshopper-340.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://perceptive-grasshopper-340.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Field PWA
VITE_CONVEX_URL=https://perceptive-grasshopper-340.convex.cloud
VITE_CONVEX_SITE_URL=https://perceptive-grasshopper-340.convex.site
VITE_SITE_URL=http://localhost:5173

# SAP connector
CONVEX_INTEGRATION_URL=https://perceptive-grasshopper-340.convex.site
CONNECTOR_ID=sunpride-local-01
# `bun run setup:env` retrieves this value without printing it.
CONNECTOR_SIGNING_SECRET=
SAP_ADAPTER=mock
SAP_BASE_URL=
SAP_USERNAME=
SAP_PASSWORD=
SAP_POLL_INTERVAL_MS=15000
CONNECTOR_PORT=4100
CONNECTOR_DB_PATH=data/connector.sqlite
