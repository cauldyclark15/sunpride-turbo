# Convex deployment selection belongs in packages/backend/.env.local.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_SITE_URL=http://localhost:5173

# SAP connector only. Never expose these to web or PWA builds.
CONVEX_INTEGRATION_URL=
CONNECTOR_ID=sunpride-local-01
CONNECTOR_SIGNING_SECRET=
SAP_BASE_URL=
SAP_USERNAME=
SAP_PASSWORD=
SAP_POLL_INTERVAL_MS=15000
CONNECTOR_PORT=4100
