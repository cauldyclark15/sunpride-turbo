# Local v2 development reference. Never commit actual connection credentials.
# API: supply DATABASE_URL and SYNC_CURSOR_SECRET privately at launch.
DATABASE_URL=
SYNC_CURSOR_SECRET=
PORT=4310
HOST=127.0.0.1
FILES_DIR=
BOOTSTRAP_ADMIN_EMAILS=

# Management web and installable office app.
API_ORIGIN=http://127.0.0.1:4310
NEXT_PUBLIC_SITE_URL=http://localhost:4300
NEXT_PUBLIC_BETA_APK_URL=
NEXT_PUBLIC_BETA_ENABLE=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# SAP mediation runs in apps/api; local contract service in apps/sap-mock.
SAP_MODE=mock
SAP_ORIGIN=http://127.0.0.1:4435
SAP_TOKEN=
SAP_TIMEOUT_MS=5000
