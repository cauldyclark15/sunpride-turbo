{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunpride.local/contracts/mobile/v1",
  "title": "Mobile SFA v1 HTTP envelopes",
  "description": "Versioned transport envelopes; domain constraints and proof-of-possession are enforced by the server.",
  "oneOf": [
    {
      "$ref": "#/$defs/bootstrapRequest"
    },
    {
      "$ref": "#/$defs/bootstrapResponse"
    },
    {
      "$ref": "#/$defs/pullRequest"
    },
    {
      "$ref": "#/$defs/pullResponse"
    },
    {
      "$ref": "#/$defs/pushRequest"
    },
    {
      "$ref": "#/$defs/pushResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "bootstrapRequest": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bootstrap.request"
        },
        "contractVersion": {
          "const": 1
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "dayFrom": {
          "type": "string",
          "format": "date"
        },
        "pageCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": ["type", "contractVersion", "deviceId"],
      "additionalProperties": false
    },
    "bootstrapResponse": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bootstrap.response"
        },
        "contractVersion": {
          "const": 1
        },
        "serverTime": {
          "type": "integer",
          "minimum": 0
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "employee": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string"
            },
            "orgUnitId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["id", "role", "orgUnitId"],
          "additionalProperties": false
        },
        "scope": {
          "type": "object",
          "properties": {
            "fingerprint": {
              "type": "string",
              "minLength": 1
            },
            "orgUnitIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": ["fingerprint", "orgUnitIds"],
          "additionalProperties": false
        },
        "appConfig": {
          "type": "object",
          "properties": {
            "offlineLeaseExpiresAt": {
              "type": "integer",
              "minimum": 0
            },
            "cacheExpiresAt": {
              "type": "integer",
              "minimum": 0
            },
            "orderCaptureEnabled": {
              "type": "boolean"
            },
            "priceAvailability": {
              "const": "unavailable"
            },
            "promotionsAvailability": {
              "const": "unavailable"
            }
          },
          "required": [
            "offlineLeaseExpiresAt",
            "cacheExpiresAt",
            "orderCaptureEnabled",
            "priceAvailability",
            "promotionsAvailability"
          ],
          "additionalProperties": false
        },
        "plannedVisits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "outletId": {
                "type": "string",
                "minLength": 1
              },
              "serviceDate": {
                "type": "string",
                "format": "date"
              },
              "planId": {
                "type": "string",
                "minLength": 1
              },
              "planVersion": {
                "type": "integer",
                "minimum": 1
              },
              "intents": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sequence": {
                "description": "Optional MCP order of the day (lower first). Added 2026-10; older servers omit it.",
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "outletId",
              "serviceDate",
              "planId",
              "planVersion",
              "intents"
            ],
            "additionalProperties": false
          }
        },
        "outlets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "routeId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "code": {
                "description": "Optional outlet (customer) code for the daily route screen. Added 2026-10; older servers omit it.",
                "type": "string"
              },
              "customerId": {
                "description": "Optional link to localCustomers[].id. Added 2026-10.",
                "type": "string",
                "minLength": 1
              },
              "address": {
                "description": "Optional outlet address used as the navigation fallback. Added 2026-10.",
                "type": "string",
                "minLength": 1
              },
              "latitude": {
                "description": "Optional current verified pin latitude; sent together with longitude or not at all. Added 2026-10.",
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "description": "Optional current verified pin longitude; sent together with latitude or not at all. Added 2026-10.",
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": ["id", "name", "routeId"],
            "dependentRequired": {
              "latitude": ["longitude"],
              "longitude": ["latitude"]
            },
            "additionalProperties": false
          }
        },
        "localCustomers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string"
              }
            },
            "required": ["id", "code"],
            "additionalProperties": false
          }
        },
        "route": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "code": {
                  "type": "string"
                }
              },
              "required": ["id", "code"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": ["id", "kind", "required"],
            "additionalProperties": false
          }
        },
        "productCatalog": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "uom": {
                "type": "string"
              }
            },
            "required": ["id", "code", "name", "uom"],
            "additionalProperties": false
          }
        },
        "callSheets": {
          "type": "array",
          "description": "Annex C call sheet per account (outlet) in this page's planned visits. Additive optional field; old clients ignore it.",
          "items": {
            "type": "object",
            "properties": {
              "outletId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "header": {
                "type": "object",
                "properties": {
                  "accountName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "address": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "buyerName": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "contactNumber": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "accountInCharge": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "receivingInCharge": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "distributorName": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "distributorSchedule": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "foc": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "pricing": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "accountName",
                  "address",
                  "buyerName",
                  "contactNumber",
                  "accountInCharge",
                  "receivingInCharge",
                  "distributorName",
                  "distributorSchedule",
                  "foc",
                  "pricing"
                ],
                "additionalProperties": false
              },
              "lines": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "properties": {
                    "productId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "uom": {
                      "type": "string"
                    },
                    "barcode": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 64
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "pricing": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 200
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "productId",
                    "code",
                    "name",
                    "uom",
                    "barcode",
                    "pricing"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": ["outletId", "revision", "header", "lines"],
            "additionalProperties": false
          }
        },
        "activityRules": {
          "type": "array",
          "description": "AND-013: activity forms each visit intent requires or offers, from backend rules. Additive optional field; old clients ignore it. Unknown intents or kinds stay raw and are never satisfiable by a form the client lacks.",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "activities": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "required": ["kind", "required"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["intent", "version", "activities"],
            "additionalProperties": false
          }
        },
        "photoTypes": {
          "type": "array",
          "description": "AND-016: photo types a visit photo may carry, from the backend. Additive optional field; old clients ignore it. The phone offers only these codes; the server rejects any other code on attach.",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": ["code", "label"],
            "additionalProperties": false
          }
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "nextPageCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "syncCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "dayTarget": {
          "description": "Optional daily position standard for the Today screen (client memo 2026-01-20, call answer 1). Added 2026-10; older servers and people without a position standard omit it.",
          "type": "object",
          "properties": {
            "dailyCalls": {
              "type": "integer",
              "minimum": 0
            },
            "productivePct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "sourceRef": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "contractVersion",
        "serverTime",
        "permissions",
        "employee",
        "scope",
        "appConfig",
        "plannedVisits",
        "outlets",
        "localCustomers",
        "route",
        "tasks",
        "productCatalog",
        "page",
        "nextPageCursor",
        "syncCursor"
      ],
      "additionalProperties": false
    },
    "pullRequest": {
      "type": "object",
      "properties": {
        "type": {
          "const": "pull.request"
        },
        "contractVersion": {
          "const": 1
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": ["type", "contractVersion", "deviceId", "cursor", "limit"],
      "additionalProperties": false
    },
    "pullResponse": {
      "type": "object",
      "properties": {
        "type": {
          "const": "pull.response"
        },
        "contractVersion": {
          "const": 1
        },
        "serverTime": {
          "type": "integer",
          "minimum": 0
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "entity": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "op": {
                "enum": ["upsert", "tombstone"]
              },
              "value": {
                "type": "object"
              }
            },
            "required": ["seq", "entity", "id", "revision", "op"],
            "additionalProperties": false
          }
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "hasMore": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "contractVersion",
        "serverTime",
        "changes",
        "nextCursor",
        "hasMore"
      ],
      "additionalProperties": false
    },
    "pushRequest": {
      "type": "object",
      "properties": {
        "type": {
          "const": "push.request"
        },
        "contractVersion": {
          "const": 1
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "visit.checkIn"
                  },
                  "clientRequestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "dependsOn": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "payload": {
                    "type": "object",
                    "properties": {
                      "clientVisitId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "plannedVisitId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "outletId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "serviceDate": {
                        "type": "string",
                        "format": "date"
                      },
                      "deviceTime": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "location": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "latitude": {
                                "type": "number",
                                "minimum": -90,
                                "maximum": 90
                              },
                              "longitude": {
                                "type": "number",
                                "minimum": -180,
                                "maximum": 180
                              },
                              "accuracyMeters": {
                                "type": "number",
                                "minimum": 0
                              },
                              "provider": {
                                "enum": ["gps", "network", "fused", "unknown"]
                              },
                              "mockSignal": {
                                "type": "boolean"
                              },
                              "fixTime": {
                                "type": "integer",
                                "minimum": 0
                              }
                            },
                            "required": [
                              "latitude",
                              "longitude",
                              "accuracyMeters",
                              "provider",
                              "fixTime"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "unplannedReason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "description": "Required by the server when plannedVisitId is null; omitted for planned visits."
                      },
                      "intents": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "sell",
                            "collect",
                            "merchandise",
                            "audit",
                            "deliver",
                            "promotion",
                            "complaint",
                            "follow-up"
                          ]
                        }
                      }
                    },
                    "required": [
                      "clientVisitId",
                      "plannedVisitId",
                      "outletId",
                      "serviceDate",
                      "deviceTime",
                      "location",
                      "intents"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": ["kind", "clientRequestId", "payload"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "visit.activity"
                  },
                  "clientRequestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "dependsOn": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "payload": {
                    "type": "object",
                    "properties": {
                      "visitId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "activity": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "const": "inventory_check"
                              },
                              "productId": {
                                "type": "string",
                                "minLength": 1
                              },
                              "icoFinding": {
                                "enum": ["present", "absent", "unknown"]
                              },
                              "observedQuantity": {
                                "anyOf": [
                                  {
                                    "type": "number",
                                    "minimum": 0
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            },
                            "required": ["kind", "productId", "icoFinding"],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "const": "merchandising"
                              },
                              "displayCondition": {
                                "enum": [
                                  "compliant",
                                  "needs_action",
                                  "not_present"
                                ]
                              },
                              "actionTaken": {
                                "type": "string"
                              }
                            },
                            "required": ["kind", "displayCondition"],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "const": "price_check"
                              },
                              "productId": {
                                "type": "string",
                                "minLength": 1
                              },
                              "observedPriceMinor": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "currency": {
                                "type": "string"
                              },
                              "compliant": {
                                "anyOf": [
                                  {
                                    "type": "boolean"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            },
                            "required": [
                              "kind",
                              "productId",
                              "observedPriceMinor",
                              "currency"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "const": "promotion"
                              },
                              "programRef": {
                                "type": "string"
                              },
                              "finding": {
                                "enum": [
                                  "executed",
                                  "not_executed",
                                  "not_applicable"
                                ]
                              }
                            },
                            "required": ["kind", "programRef", "finding"],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "const": "order_intent"
                              },
                              "clientOrderId": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "note": {
                                "type": "string"
                              }
                            },
                            "required": ["kind", "clientOrderId"],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "const": "note"
                              },
                              "text": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2000
                              }
                            },
                            "required": ["kind", "text"],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "const": "call_sheet"
                              },
                              "lines": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 100,
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "productId": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "order": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 0,
                                          "maximum": 1000000
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "beginningInventory": {
                                      "anyOf": [
