      "ng",
      "sari",
      "sarisari",
      "shop",
      "store",
      "stores",
      "the",
      "trading"
    ],
    "nameTokens": "NFKD, drop combining marks, lowercase, replace every run of characters outside [a-z0-9] with one space, split; drop stopwords; if nothing is left keep all the words. Token SET.",
    "nameSimilarity": "Jaccard of the two token sets = |A∩B| / |A∪B|, rounded to 4 decimals; 0 when either set is empty.",
    "phoneKey": "digits only; 12 digits starting 63 -> '0' + the last 10; key = last 10 digits; fewer than 10 digits -> no key (never matches).",
    "distance": "haversine, earth radius 6371008.8 m, rounded to 0.1 m; unknown when either side has no coordinates.",
    "reasons": "in this order: 'place' (same non-empty Google place id), 'phone' (same phone key), 'nearby' (distance <= 75 m), 'name' (nameSimilarity >= 0.8 and (distance unknown or <= 2000 m)). A candidate has at least one reason.",
    "score": "place 100, phone 90, nearby: 80 if distance <= 25 m else 60, name adds round(30 * nameSimilarity). Sum. Sort by score desc, then distance asc (unknown last), then name. Return at most 10."
  },
