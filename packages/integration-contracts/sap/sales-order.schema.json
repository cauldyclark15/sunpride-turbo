{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunpride.local/contracts/sap/sales-order.v1.json",
  "title": "Sales Order Submit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["orderNumber", "customerCode", "currency", "lines", "total"],
  "properties": {
    "orderNumber": { "type": "string", "minLength": 1 },
    "customerCode": { "type": "string", "minLength": 1 },
    "currency": { "const": "PHP" },
    "total": { "type": "number", "minimum": 0 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productCode", "quantity", "unitPrice"],
        "properties": {
          "productCode": { "type": "string", "minLength": 1 },
          "quantity": { "type": "number", "exclusiveMinimum": 0 },
          "unitPrice": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
