{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunpride.local/contracts/sap/v1/location.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "organizationId": {
      "const": "sunpride"
    },
    "kind": {
      "const": "location"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source": {
      "enum": ["sample", "sap"]
    },
    "effectiveFrom": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "effectiveTo": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "deleted": {
      "type": "boolean"
    },
    "data": {
      "type": "object",
      "properties": {
        "locationCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "plant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "storageLocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": ["active", "inactive"]
        }
      },
      "required": ["locationCode", "plant", "storageLocation", "status"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "organizationId",
    "kind",
    "key",
    "version",
    "source",
    "effectiveFrom",
    "effectiveTo",
    "deleted",
    "data"
  ],
  "additionalProperties": false
}
