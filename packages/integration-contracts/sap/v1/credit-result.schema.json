{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunpride.local/contracts/sap/v1/credit-result.schema.json",
  "type": "object",
  "properties": {
    "overrideSourceType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "overrideSourceId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "overrideReference": { "type": "string", "minLength": 1, "maxLength": 200 },
    "schemaVersion": {
      "const": 1
    },
    "customerCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "amountCentavos": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currency": {
      "const": "PHP"
    },
    "reserve": { "type": "boolean" },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "decisionToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checkedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "enum": ["within", "over", "no_limit", "unknown"]
    },
    "limitCentavos": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "exposureCentavos": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "projectedExposureCentavos": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    },
    "source": {
      "enum": ["sample", "sap"]
    }
  },
  "required": [
    "schemaVersion",
    "customerCode",
    "amountCentavos",
    "currency",
    "reserve",
    "requestId",
    "decisionToken",
    "expiresAt",
    "checkedAt",
    "status",
    "limitCentavos",
    "exposureCentavos",
    "projectedExposureCentavos",
    "source"
  ],
  "additionalProperties": false
}
