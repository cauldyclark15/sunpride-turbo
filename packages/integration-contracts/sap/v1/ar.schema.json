{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunpride.local/contracts/sap/v1/ar.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "organizationId": {
      "const": "sunpride"
    },
    "kind": {
      "const": "ar"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source": {
      "enum": ["sample", "sap"]
    },
    "effectiveFrom": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "effectiveTo": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "deleted": {
      "type": "boolean"
    },
    "data": {
      "type": "object",
      "properties": {
        "customerCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "documentNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "dueAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "amountCentavos": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "const": "PHP"
        }
      },
      "required": [
        "customerCode",
        "documentNumber",
        "dueAt",
        "amountCentavos",
        "currency"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "organizationId",
    "kind",
    "key",
    "version",
    "source",
    "effectiveFrom",
    "effectiveTo",
    "deleted",
    "data"
  ],
  "additionalProperties": false
}
