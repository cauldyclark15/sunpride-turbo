{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunpride.local/contracts/sap/v1/goods_movement.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "organizationId": {
      "const": "sunpride"
    },
    "kind": {
      "const": "goods_movement"
    },
    "effectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "document": {
      "type": "object",
      "properties": {
        "sourceType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "customerCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "const": "PHP"
        },
        "amountCentavos": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "occurredAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "quantityBase": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "lotId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fromLocationCode": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "toLocationCode": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unitPriceCentavos": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "taxCode": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "taxBasisPoints": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "productCode",
              "uom",
              "quantityBase",
              "lotId",
              "fromLocationCode",
              "toLocationCode",
              "unitPriceCentavos",
              "taxCode",
              "taxBasisPoints"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "facts": {
          "type": "object"
        }
      },
      "required": [
        "sourceType",
        "sourceId",
        "customerCode",
        "currency",
        "amountCentavos",
        "occurredAt",
        "lines",
        "facts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "organizationId",
    "kind",
    "effectId",
    "correlationId",
    "document"
  ],
  "additionalProperties": false
}
