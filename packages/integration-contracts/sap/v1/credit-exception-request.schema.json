{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunpride.local/contracts/sap/v1/credit-exception-request.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "customerCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "amountCentavos": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currency": {
      "const": "PHP"
    },
    "sourceType": {
      "enum": ["next_document", "order", "van_sale", "distributor_order"]
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "approvalReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "customerCode",
    "amountCentavos",
    "currency",
    "sourceType",
    "sourceId",
    "approvalReference",
    "approvedBy",
    "reason",
    "expiresAt"
  ],
  "additionalProperties": false
}
