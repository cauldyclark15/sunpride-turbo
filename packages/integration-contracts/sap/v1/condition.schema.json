{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunpride.local/contracts/sap/v1/condition.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "organizationId": {
      "const": "sunpride"
    },
    "kind": {
      "const": "condition"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source": {
      "enum": ["sample", "sap"]
    },
    "effectiveFrom": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "effectiveTo": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "deleted": {
      "type": "boolean"
    },
    "data": {
      "type": "object",
      "properties": {
        "productCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "uom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "customerCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "channelKey": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "const": "PHP"
        },
        "unitPriceCentavos": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sellingUnitPriceCentavos": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unitTaxCentavos": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "taxCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "taxBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "taxTreatment": {
          "enum": ["vatable", "exempt", "zero_rated"]
        },
        "taxInclusive": {
          "type": "boolean"
        },
        "precedence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "priceListCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "productCode",
        "uom",
        "customerCode",
        "channelKey",
        "currency",
        "unitPriceCentavos",
        "taxCode",
        "taxBasisPoints",
        "taxInclusive",
        "precedence",
        "priceListCode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "organizationId",
    "kind",
    "key",
    "version",
    "source",
    "effectiveFrom",
    "effectiveTo",
    "deleted",
    "data"
  ],
  "additionalProperties": false
}
