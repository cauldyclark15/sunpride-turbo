{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunpride.local/contracts/sap/v1/stock.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "organizationId": {
      "const": "sunpride"
    },
    "kind": {
      "const": "stock"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source": {
      "enum": ["sample", "sap"]
    },
    "effectiveFrom": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "effectiveTo": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "deleted": {
      "type": "boolean"
    },
    "data": {
      "type": "object",
      "properties": {
        "productCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "locationCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "onHandBase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reservedBase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "valueCentavos": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unitCostCentavos": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quantityScale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "currency": {
          "const": "PHP"
        }
      },
      "required": [
        "productCode",
        "locationCode",
        "onHandBase",
        "reservedBase",
        "valueCentavos",
        "unitCostCentavos",
        "quantityScale",
        "currency"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "organizationId",
    "kind",
    "key",
    "version",
    "source",
    "effectiveFrom",
    "effectiveTo",
    "deleted",
    "data"
  ],
  "additionalProperties": false
}
