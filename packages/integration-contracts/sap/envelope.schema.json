{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunpride.local/contracts/sap/envelope.v1.json",
  "title": "Sunpride SAP Integration Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "eventId",
    "eventType",
    "occurredAt",
    "source",
    "payload"
  ],
  "properties": {
    "contractVersion": { "enum": ["1.0", "1.1"] },
    "eventId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "eventType": {
      "type": "string",
      "pattern": "^(master-data\\.|inventory\\.|sales-order\\.|delivery\\.).+"
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "enum": ["sap", "sunpride"] },
    "organizationCode": { "type": "string", "minLength": 1 },
    "sourceSequence": { "type": "string", "maxLength": 128 },
    "sentAt": { "type": "string", "format": "date-time" },
    "idempotencyKey": { "type": "string", "maxLength": 160 },
    "payloadHash": { "type": "string", "maxLength": 128 },
    "correlationId": { "type": "string", "maxLength": 128 },
    "causationId": { "type": "string", "maxLength": 128 },
    "payload": { "type": "object" }
  }
}
