{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["CONVEX_SITE_URL", "WEB_SITE_URL", "PWA_SITE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "NEXT_PUBLIC_CONVEX_URL",
        "NEXT_PUBLIC_CONVEX_SITE_URL",
        "VITE_CONVEX_URL",
        "VITE_CONVEX_SITE_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck", "^codegen"] },
    "test": { "dependsOn": ["^build"] },
    "test:e2e": { "cache": false },
    "codegen": { "cache": false, "outputs": ["convex/_generated/**"] },
    "dev": { "cache": false, "persistent": true },
    "deploy": { "cache": false }
  }
}
