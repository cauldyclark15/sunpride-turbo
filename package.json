{
  "name": "sunpride-turbo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@sunpride/web",
    "dev:pwa": "turbo run dev --filter=@sunpride/pwa",
    "dev:sap": "turbo run dev --filter=@sunpride/sap-connector",
    "dev:backend": "turbo run dev --filter=@sunpride/backend",
    "setup:env": "bun scripts/setup-local-env.ts",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{js,json,md,ts,tsx,css}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,ts,tsx,css}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check": "turbo run lint typecheck test build",
    "codegen": "turbo run codegen --filter=@sunpride/backend"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "heroui-pro",
    "@heroui-pro/react"
  ]
}
