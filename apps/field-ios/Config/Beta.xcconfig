// SP-0132 beta build ("Sunpride Field (Beta)", com.sunpride.field.beta). Public addresses only, never
// tokens or credentials. scripts/build-beta.sh overrides SUNPRIDE_API_ORIGIN from SUNPRIDE_BETA_API_URL
// and SUNPRIDE_BETA_BUILD when they are set.
// Xcode config uses $() to escape `//`.
SUNPRIDE_API_ORIGIN = https:/$()/sunpride.cauldnclark.com
// "Report an issue" opens $(FIELD_WEB_URL)/issues/new; empty hides the link.
FIELD_WEB_URL = https:/$()/sunpride.cauldnclark.com
SUNPRIDE_BETA_BUILD = 1
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = $(SUNPRIDE_BETA_BUILD)
FIELD_VERSION_LABEL = 1.0.0-beta.$(SUNPRIDE_BETA_BUILD)
FIELD_DISPLAY_NAME = Sunpride Field (Beta)
