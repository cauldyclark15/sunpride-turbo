// Local-only endpoints. Never store tokens or credentials here.
// Replace via gitignored Local.xcconfig or CI build settings for a real DEV endpoint.
CONVEX_SITE_URL = http:/$()/localhost:3000
CONVEX_URL = http:/$()/localhost:3001
// "Report an issue" (Account) opens $(FIELD_WEB_URL)/issues/new: the Sunpride web tracker. Empty hides it.
FIELD_WEB_URL = https:/$()/sunpride.keepr.im
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
FIELD_VERSION_LABEL = $(MARKETING_VERSION)
FIELD_DISPLAY_NAME = Sunpride Field (Dev)
#include? "Local.xcconfig"
