<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<!-- The one Face ID / Touch ID switch, read by AppModel.biometricsEnabled and FieldIOSUITests. Off by owner decision 2026-11-08. -->
<key>FieldBiometricsEnabled</key><false/>
<key>CFBundleDisplayName</key><string>$(FIELD_DISPLAY_NAME)</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>UILaunchScreen</key><dict><key>UIColorName</key><string>LaunchBackground</string><key>UIImageName</key><string>SunprideLogo</string><key>UIImageRespectsSafeAreaInsets</key><true/></dict>
<key>LSApplicationQueriesSchemes</key><array><string>comgooglemaps</string><string>waze</string></array>
<key>NSLocationWhenInUseUsageDescription</key><string>Tag a store location for up to 15 minutes after saving, show how far today's stores are, record call locations, and share work-day location with your supervisor until End day, sign-out or 10 PM.</string>
<key>NSLocationAlwaysAndWhenInUseUsageDescription</key><string>Finish tagging a store for up to 15 minutes after saving while the phone is in your pocket, or share your work-day location until End day, sign-out or 10 PM.</string>
<key>NSLocationTemporaryUsageDescriptionDictionary</key><dict><key>VisitCheckIn</key><string>Precise location shows your supervisor you were at the store when you started or ended the visit.</string></dict>
<key>NSCameraUsageDescription</key><string>Take visit photos (store front, shelf, price tags) as evidence for your supervisor. Photos stay locked in this app until they upload; they are never saved to your photo library.</string>
<key>NSFaceIDUsageDescription</key><string>Open Sunpride Field with Face ID instead of typing your password. Your password is never saved on this phone.</string>
<key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.sunpride.field.dev.sync-refresh</string></array>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
<key>UISupportedInterfaceOrientations~ipad</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationPortraitUpsideDown</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
<key>UIBackgroundModes</key><array><string>fetch</string><string>location</string></array>
<key>SUNPRIDE_API_ORIGIN</key><string>$(SUNPRIDE_API_ORIGIN)</string>
<key>FIELD_WEB_URL</key><string>$(FIELD_WEB_URL)</string>
<key>FIELD_VERSION_LABEL</key><string>$(FIELD_VERSION_LABEL)</string>
</dict></plist>
