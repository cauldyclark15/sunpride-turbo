<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>$(FIELD_DISPLAY_NAME)</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>UILaunchScreen</key><dict><key>UIColorName</key><string>LaunchBackground</string><key>UIImageName</key><string>SunprideLogo</string><key>UIImageRespectsSafeAreaInsets</key><true/></dict>
<key>LSApplicationQueriesSchemes</key><array><string>comgooglemaps</string><string>waze</string></array>
<key>NSLocationWhenInUseUsageDescription</key><string>Show how far today's stores are and record a location fix when you start and end a call. Call locations are sent to the server only when you sync.</string>
<key>NSLocationTemporaryUsageDescriptionDictionary</key><dict><key>VisitCheckIn</key><string>Precise location shows your supervisor you were at the store when you started or ended the visit.</string></dict>
<key>NSCameraUsageDescription</key><string>Take visit photos (store front, shelf, price tags) as evidence for your supervisor. Photos stay locked in this app until they upload; they are never saved to your photo library.</string>
<key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.sunpride.field.dev.sync-refresh</string></array>
<key>UIBackgroundModes</key><array><string>fetch</string></array>
<key>CONVEX_SITE_URL</key><string>$(CONVEX_SITE_URL)</string>
<key>CONVEX_URL</key><string>$(CONVEX_URL)</string>
<key>FIELD_WEB_URL</key><string>$(FIELD_WEB_URL)</string>
<key>FIELD_VERSION_LABEL</key><string>$(FIELD_VERSION_LABEL)</string>
</dict></plist>
