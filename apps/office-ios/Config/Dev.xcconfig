// The Sunpride server this build talks to (public address only; never tokens or credentials).
// For a local simulator proof, override in a gitignored Config/Local.xcconfig, e.g.
//   SUNPRIDE_API_ORIGIN = http:/$()/127.0.0.1:4620
// Xcode config uses $() to escape `//`.
SUNPRIDE_API_ORIGIN = https:/$()/sunpride.cauldnclark.com
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
OFFICE_VERSION_LABEL = $(MARKETING_VERSION)
OFFICE_DISPLAY_NAME = Sunpride Office (Dev)
#include? "Local.xcconfig"
