# Local connector values for the shared development deployment.
# Copy this file to `.env.local`, or run `bun run setup:env` from the repo root.
CONVEX_INTEGRATION_URL=https://perceptive-grasshopper-340.convex.site
CONNECTOR_ID=sunpride-local-01
# Never commit this secret. `bun run setup:env` retrieves the current value
# from Convex without printing it when your Convex account has project access.
CONNECTOR_SIGNING_SECRET=
SAP_ADAPTER=mock
SAP_BASE_URL=
SAP_USERNAME=
SAP_PASSWORD=
SAP_POLL_INTERVAL_MS=15000
CONNECTOR_PORT=4100
CONNECTOR_DB_PATH=data/connector.sqlite
