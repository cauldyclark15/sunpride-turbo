{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["$TURBO_EXTENDS$", "API_ORIGIN"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/training/**",
        "$TURBO_ROOT$/apps/api/src/**",
        "$TURBO_ROOT$/packages/ui/src/**"
      ]
    }
  }
}
