# Management web app local development values.
# Copy this file to `.env.local`, or run `bun run setup:env` from the repo root.
NEXT_PUBLIC_CONVEX_URL=https://perceptive-grasshopper-340.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://perceptive-grasshopper-340.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Beta release (see apps/web/docs/BETA_RELEASE.md).
# Link to the Android APKs shown on /help; leave empty to hide the download section.
NEXT_PUBLIC_BETA_APK_URL=
# Comma-separated hidden beta features to switch back on (or `all`); empty keeps them hidden.
NEXT_PUBLIC_BETA_ENABLE=
