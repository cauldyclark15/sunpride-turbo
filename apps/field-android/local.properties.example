# Copy to local.properties. Non-secret server origins only; every flavor defaults to
# https://sunpride.cauldnclark.com when unset. Never put passwords, tokens or signing material here.
# SUNPRIDE_DEV_API_ORIGIN=http://10.0.2.2:4310
# SUNPRIDE_STAGING_API_ORIGIN=
# SUNPRIDE_PROD_API_ORIGIN=
# SUNPRIDE_BETA_API_ORIGIN=
# Web app for Account > Report an issue (opens <url>/issues/new); hidden when empty.
SUNPRIDE_BETA_WEB_URL=
SUNPRIDE_BETA_BUILD=1
# Signing key lives outside the repo; created by scripts/create-beta-keystore.sh.
# SUNPRIDE_BETA_SIGNING_PROPERTIES=~/.sunpride-keys/field-beta.properties
