# Public Sunpride server origin only. Never put passwords, session tokens or signing material here.
# One origin for every flavor; a per-flavor SUNPRIDE_<DEV|STAGING|PROD|BETA>_API_ORIGIN overrides it.
SUNPRIDE_API_ORIGIN=https://sunpride.cauldnclark.com
SUNPRIDE_BETA_WEB_URL=https://sunpride.cauldnclark.com
SUNPRIDE_BETA_BUILD=1
# Signing key remains outside the repo.
# SUNPRIDE_VAN_BETA_SIGNING_PROPERTIES=~/.sunpride-keys/van-beta.properties
